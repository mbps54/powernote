#!/bin/sh
set -eu

ensure_chain() {
    table="$1"
    chain="$2"
    iptables -w -t "$table" -N "$chain" 2>/dev/null || true
    iptables -w -t "$table" -F "$chain"
}

ensure_jump() {
    table="$1"
    parent="$2"
    child="$3"
    iptables -w -t "$table" -C "$parent" -j "$child" 2>/dev/null || \
        iptables -w -t "$table" -I "$parent" 1 -j "$child"
}

ensure_chain filter POWERNOTE_VPN_INPUT
iptables -w -A POWERNOTE_VPN_INPUT -p udp --dport 500 -j ACCEPT
iptables -w -A POWERNOTE_VPN_INPUT -p udp --dport 4500 -j ACCEPT
iptables -w -A POWERNOTE_VPN_INPUT -p esp -j ACCEPT
iptables -w -A POWERNOTE_VPN_INPUT -p udp --dport 1701 -m policy --dir in --pol ipsec -j ACCEPT
iptables -w -A POWERNOTE_VPN_INPUT -p udp --dport 1701 -j DROP
iptables -w -A POWERNOTE_VPN_INPUT -j RETURN
ensure_jump filter INPUT POWERNOTE_VPN_INPUT

ensure_chain filter POWERNOTE_VPN_FORWARD
iptables -w -A POWERNOTE_VPN_FORWARD -s {{ l2tp_vpn_subnet }} -o {{ l2tp_vpn_external_interface }} -j ACCEPT
iptables -w -A POWERNOTE_VPN_FORWARD -d {{ l2tp_vpn_subnet }} -i {{ l2tp_vpn_external_interface }} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -w -A POWERNOTE_VPN_FORWARD -j RETURN
ensure_jump filter FORWARD POWERNOTE_VPN_FORWARD

ensure_chain nat POWERNOTE_VPN_NAT
iptables -w -t nat -A POWERNOTE_VPN_NAT -s {{ l2tp_vpn_subnet }} -o {{ l2tp_vpn_external_interface }} -j MASQUERADE
ensure_jump nat POSTROUTING POWERNOTE_VPN_NAT
